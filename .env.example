# URL pública del portafolio, sin barra final. Se usa en metadataBase, canonical, hreflang,
# Open Graph, sitemap y robots. Si falta: dominio de producción de Vercel, URL del preview o localhost.
# Es NEXT_PUBLIC_*: se incrusta en build, así que cambiarla requiere redeploy.
NEXT_PUBLIC_SITE_URL=https://bryandelacruz.dev

# Formulario de contacto (Resend). Plan gratis: 3.000 correos/mes, 100/día.
# Sin RESEND_API_KEY el formulario muestra un aviso y deja el correo como alternativa.
RESEND_API_KEY=
# Opcionales. Sin dominio verificado en Resend el remitente debe ser onboarding@resend.dev
# y el destino solo puede ser el correo con el que creaste la cuenta de Resend.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=bryan.delacruza@gmail.com
# Opcional: clave para firmar el token anti-bots del formulario. Si falta, se usa RESEND_API_KEY.
CONTACT_FORM_SECRET=
